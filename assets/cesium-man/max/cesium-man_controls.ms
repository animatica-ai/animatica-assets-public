#("leg_settings_L", "", "leg_joint_L_3", "leg_joint_L_3", "settings", "leg_L", "L", "other", "diamond", (matrix3 [1.000000,0.000000,0.000000] [0.000000,0.000000,1.000000] [0.000000,-1.000000,0.000000] [3.287096,0.180145,3.378405]), (color 64 128 255), #(#(false, #([3.287096,4.020646,4.658572], [4.567263,4.020646,3.378405], [3.287096,4.020646,2.098237], [2.006929,4.020646,3.378405], [3.287096,4.020646,4.658572], [3.287096,2.740479,3.378405], [3.287096,4.020646,2.098237], [3.287096,5.300814,3.378405], [3.287096,4.020646,4.658572])), #(false, #([4.567263,4.020646,3.378405], [3.287096,2.740479,3.378405], [2.006929,4.020646,3.378405], [3.287096,5.300814,3.378405], [4.567263,4.020646,3.378405])))),
#("leg_settings_R", "", "leg_joint_R_3", "leg_joint_R_3", "settings", "leg_R", "R", "other", "diamond", (matrix3 [1.000000,0.000000,0.000000] [0.000000,0.000000,1.000000] [0.000000,-1.000000,0.000000] [-2.893575,0.178455,3.378363]), (color 255 76 64), #(#(false, #([-2.893575,4.018948,4.658527], [-1.613411,4.018948,3.378363], [-2.893575,4.018948,2.098198], [-4.173740,4.018948,3.378363], [-2.893575,4.018948,4.658527], [-2.893575,2.738784,3.378363], [-2.893575,4.018948,2.098198], [-2.893575,5.299113,3.378363], [-2.893575,4.018948,4.658527])), #(false, #([-1.613411,4.018948,3.378363], [-2.893575,2.738784,3.378363], [-4.173740,4.018948,3.378363], [-2.893575,5.299113,3.378363], [-1.613411,4.018948,3.378363]))))),
	-- Line tube thickness (cm) and sides.
	lineThickness = 0.3,
	lineSides = 6,
	-- #(limb, #(scene bones: the 3 chain bones (+ the toe)), ikfk default) per
	-- complete limb (control_plan.plan()["limbs"]).
	limbs = #(#("leg_L", #("leg_joint_L_1", "leg_joint_L_2", "leg_joint_L_3", "leg_joint_L_5"), 0.0), #("leg_R", #("leg_joint_R_1", "leg_joint_R_2", "leg_joint_R_3", "leg_joint_R_5"), 0.0)),
	-- hideInactive default (soma77_rigify.json switches.hideInactive.default).
	hideInactiveDefault = 1,
	-- #(control, translate axes, rotate axes, scale axes) locked in Maya
	-- (soma77_maya.json locks; axes of the Maya control frame).
	locks = #(#("thigh_fk_L", #("X", "Y", "Z"), #(), #("X", "Y", "Z")), #("thigh_fk_R", #("X", "Y", "Z"), #(), #("X", "Y", "Z")), #("shin_fk_L", #("X", "Y", "Z"), #("Y", "Z"), #("X", "Y", "Z")), #("shin_fk_R", #("X", "Y", "Z"), #("Y", "Z"), #("X", "Y", "Z")), #("foot_fk_L", #("X", "Y", "Z"), #(), #("X", "Y", "Z")), #("foot_fk_R", #("X", "Y", "Z"), #(), #("X", "Y", "Z")), #("toe_fk_L", #("X", "Y", "Z"), #(), #("X", "Y", "Z")), #("toe_fk_R", #("X", "Y", "Z"), #(), #("X", "Y", "Z")), #("foot_ik_L", #(), #(), #("X", "Y", "Z")), #("foot_ik_R", #(), #(), #("X", "Y", "Z")), #("leg_pole_L", #(), #("X", "Y", "Z"), #("X", "Y", "Z")), #("leg_pole_R", #(), #("X", "Y", "Z"), #("X", "Y", "Z")), #("toe_ik_L", #("X", "Y", "Z"), #(), #("X", "Y", "Z")), #("toe_ik_R", #("X", "Y", "Z"), #(), #("X", "Y", "Z")), #("shoulder_L", #("X", "Y", "Z"), #(), #("X", "Y", "Z")), #("shoulder_R", #("X", "Y", "Z"), #(), #("X", "Y", "Z")), #("spine_01", #("X", "Y", "Z"), #(), #("X", "Y", "Z")), #("neck_01", #("X", "Y", "Z"), #(), #("X", "Y", "Z")), #("head_ctrl", #("X", "Y", "Z"), #(), #("X", "Y", "Z")), #("root_ctrl", #(), #(), #("X", "Y", "Z")), #("body_ctrl", #(), #(), #("X", "Y", "Z")), #("hips_ctrl", #(), #(), #("X", "Y", "Z")), #("chest_ctrl", #(), #(), #("X", "Y", "Z")), #("leg_settings_L", #("X", "Y", "Z"), #("X", "Y", "Z"), #("X", "Y", "Z")), #("leg_settings_R", #("X", "Y", "Z"), #("X", "Y", "Z"), #("X", "Y", "Z"))),
	-- Filled by build(): the controls whose ctrl: bone follows them by constraints,
	-- #(chain, swivel turn in degrees (of the hidden swivel target from the pole
	-- control, about the limb axis), remaining difference) per IK chain, the
	-- CTRL_ control nodes made, the number of controls locked and
	-- #(control, reason) for each lock left out.
	constrained = #(),
	swivelTurns = #(),
	controlNodes = #(),
	locksApplied = 0,
	locksSkipped = #(),

	fn sceneBone joint =
	(
		local found = undefined
		for p in jointMap where p[1] == joint do found = getNodeByName p[2] exact:true
		found
	),

	-- "<prefix><bone name without namespace>": the ctrl:, ik: and fk: copies.
	fn twinName prefix boneName =
	(
		local parts = filterString boneName ":"
		prefix + parts[parts.count]
	),

	fn ctrlName boneName = twinName "ctrl:" boneName,

	fn ctrlOf n = getNodeByName (ctrlName n.name) exact:true,

	fn copyOf prefix boneName = if boneName == "" then undefined else getNodeByName (twinName prefix boneName) exact:true,

	-- The node's world transform without its scale (the Armature carries 0.3937).
	fn cleanTM m = matrix3 (normalize m.row1) (normalize m.row2) (normalize m.row3) m.row4,

	fn localTM n = if n.parent == undefined then n.transform else n.transform * inverse n.parent.transform,

	-- Largest element difference between two arrays of world transforms
	-- (positions in system units).
	fn tmDiff a b =
	(
		local d = 0.0
		for i = 1 to a.count do for r = 1 to 4 do
		(
			local v = a[i][r] - b[i][r]
			d = amax #(d, abs v.x, abs v.y, abs v.z)
		)
		d
	),

	fn turnAbout p centre axis ang =
	(
		local v = p - centre
		centre + v * (cos ang) + (cross axis v) * (sin ang) + axis * ((dot axis v) * (1.0 - cos ang))
	),

	-- Where the swivel target has to sit is the solver's business: on a nearly
	-- straight limb HI IK has no bend plane of its own, and on a bent one the
	-- knee may flip to the far side of a target placed "in front". So turn the
	-- target about the limb axis to wherever the limb (start, middle, end bone)
	-- comes back closest to its rest pose: a coarse sweep, then halving steps.
	-- Returns #(the turn in degrees, the remaining difference).
	fn alignSwivel st mid en sw rest =
	(
		local centre = rest[1].pos
		local axis = normalize (rest[3].pos - centre)
		local base = sw.pos
		local best = 0.0
		local bestErr = 1e30
		for ang = 0.0 to 330.0 by 30.0 do
		(
			sw.pos = turnAbout base centre axis ang
			local err = tmDiff rest #(st.transform, mid.transform, en.transform)
			if err < bestErr do ( bestErr = err; best = ang )
		)
		local stp = 15.0
		while stp > 1e-4 do
		(
			local improved = false
			for ang in #(best - stp, best + stp) do
			(
				sw.pos = turnAbout base centre axis ang
				local err = tmDiff rest #(st.transform, mid.transform, en.transform)
				if err < bestErr do ( bestErr = err; best = ang; improved = true )
			)
			if not improved do stp *= 0.5
		)
		sw.pos = turnAbout base centre axis best
		#(best, bestErr)
	),

	-- Thick lines: the shape is shown as a tube in the viewport (never rendered),
	-- Max's counterpart of Blender's wire width and Maya's lineWidth.
	fn style s col =
	(
		local t = lineThickness * (units.decodeValue "1cm")
		s.wirecolor = col
		s.render_renderable = false
		s.render_displayRenderMesh = true
		s.render_useViewportSettings = true
		s.render_viewport_thickness = t
		s.render_viewport_sides = lineSides
		s.render_thickness = t
		s.render_sides = lineSides
		s
	),

	-- Gives a shape node tm's axes (cleanTM tm) without moving its geometry.
	fn keepGeometry s tm =
	(
		local geo = s.objectTransform
		s.transform = cleanTM tm
		local offTM = geo * inverse s.transform
		s.objectOffsetRot = offTM.rotationpart
		s.objectOffsetPos = offTM.translationpart
	),

	-- The plan entry's shape (world points) as a SplineShape CTRL_<name> whose
	-- node takes tm's axes: a circle part is a closed smooth curve through its
	-- points, any other part a polyline.
	fn makeShape e tm parentNode =
	(
		local s = SplineShape name:("CTRL_" + e[1])
		for part in e[12] do
		(
			local k = addNewSpline s
			if part[1] then
			(
				for p in part[2] do addKnot s k #smooth #curve p
				close s k
			)
			else for p in part[2] do addKnot s k #corner #line p
		)
		updateShape s
		keepGeometry s tm
		s.parent = parentNode
		style s e[11]
	),

	fn twin boneName = if boneName == "" then undefined else getNodeByName (ctrlName boneName) exact:true,

	fn entryOf controlName = (local r = undefined; for e in controlPlan where e[1] == controlName do r = e; r),

	-- The scene bones the IK chains end on (their limbIk control is the IK goal).
	fn ikEnds = (local r = #(); for s in ikChains do (local b = sceneBone s[3]; if b != undefined do append r b.name); r),

	fn isIkEnd e = e[5] == "limbIk" and findItem (ikEnds()) e[3] > 0,

	-- The bone a control moves: its joint's ctrl: twin for the controls on the
	-- body, the shoulders and the fingers; the fk: copy for an FK limb control;
	-- the ik: copy for toe_ik; undefined for the rest (root, body, IK goals -
	-- they carry the HI IK chain -, poles, settings).
	fn leadBone e =
	(
		case of
		(
			(findItem #("centre", "shoulder", "finger") e[5] > 0): twin e[3]
			(e[5] == "limbFk"): copyOf "fk:" e[3]
			(e[5] == "limbIk" and not isIkEnd e): copyOf "ik:" e[3]
			default: undefined
		)
	),

	-- The bone a control's children hang from: the bone it leads, or for an IK
	-- goal the ik: end bone it orients (foot_ik > toe_ik).
	fn boneUnder e = if isIkEnd e then copyOf "ik:" e[3] else leadBone e,

	fn limbEntry key = (local r = undefined; for l in limbs where l[1] == key do r = l; r),

	-- The limb's controls of the given kinds, as nodes.
	fn limbControls key kinds =
	(
		local r = #()
		for e in controlPlan where e[6] == key and findItem kinds e[5] > 0 do
		(
			local n = getNodeByName ("CTRL_" + e[1]) exact:true
			if n != undefined do append r n
		)
		r
	),

	-- Custom attributes: the root's switches and a limb's IK/FK blend.
	fn rigAttributes =
	(
		attributes AnimaticaRig
		(
			parameters main rollout:params
			(
				controlRig type:#integer default:1 ui:spnRig animatable:true
				hideInactive type:#integer default:1 ui:spnHide animatable:true
			)
			rollout params "Animatica"
			(
				spinner spnRig "controlRig" type:#integer range:[0, 1, 1]
				spinner spnHide "hideInactive" type:#integer range:[0, 1, 1]
			)
		)
	),

	fn limbAttributes =
	(
		attributes AnimaticaLimb
		(
			parameters main rollout:params
			(
				ikfk type:#float default:0.0 ui:spnIkfk animatable:true
			)
			rollout params "Animatica"
			(
				spinner spnIkfk "ikfk (0 IK, 1 FK)" type:#float range:[0, 1, 0] scale:0.01
			)
		)
	),

	-- A float expression of the named controllers, e.g. "if(k > 0, 1, 1 - h)".
	fn expr text names ctrls =
	(
		local fe = Float_Expression()
		for i = 1 to names.count do fe.AddScalarTarget names[i] ctrls[i]
		fe.setExpression text
		fe
	),

	fn remove =
	(
		for p in jointMap do
		(
			local b = getNodeByName p[2] exact:true
			if b != undefined do
			(
				local rc = b.rotation.controller
				if classOf rc == Rotation_List do
				(
					local keep = undefined
					for i = 1 to rc.count do
						if keep == undefined and classOf rc[i].controller == Euler_XYZ do keep = rc[i].controller
					b.rotation.controller = if keep != undefined then keep else Euler_XYZ()
				)
				local pc = b.position.controller
				if classOf pc == Position_List do
				(
					local keep = undefined
					for i = 1 to pc.count do
						if keep == undefined and classOf pc[i].controller == Position_XYZ do keep = pc[i].controller
					b.position.controller = if keep != undefined then keep else Position_XYZ()
				)
			)
		)
		-- The custom attributes, wiring and visibility controllers live on these
		-- nodes and go with them.
		delete (for o in objects where matchPattern o.name pattern:"ctrl:*" ignoreCase:false \
			or matchPattern o.name pattern:"ik:*" ignoreCase:false \
			or matchPattern o.name pattern:"fk:*" ignoreCase:false \
			or matchPattern o.name pattern:"CTRL_*" ignoreCase:false collect o)
		ok
	),

	-- The Maya locks on the controls (setTransformLockFlags, node axes).
	-- Translate and scale locks name all three axes or none, so they hold in any
	-- axes. A rotate lock that leaves one Maya axis free (a hinge) is applied
	-- only when that axis is within 10 degrees of a node axis (the node has the
	-- bone's axes, the Maya frame its own); otherwise it is left out (locksSkipped).
	fn applyLocks =
	(
		locksApplied = 0
		locksSkipped = #()
		for l in locks do
		(
			local n = getNodeByName ("CTRL_" + l[1]) exact:true
			local e = entryOf l[1]
			if n != undefined and e != undefined do
			(
				local flags = #{}
				local why = #()
				if l[2].count == 3 then flags += #{1, 2, 3} else if l[2].count > 0 do append why "partial translate lock"
				if l[4].count == 3 then flags += #{7, 8, 9} else if l[4].count > 0 do append why "partial scale lock"
				if l[3].count == 3 then flags += #{4, 5, 6}
				else if l[3].count == 2 then
				(
					local free = 0
					for i = 1 to 3 where findItem l[3] #("X", "Y", "Z")[i] == 0 do free = i
					local v = (e[10] * inverse (cleanTM n.transform))[free]
					local a = #(abs v.x, abs v.y, abs v.z)
					local k = findItem a (amax a)
					local ang = acos (amin 1.0 (amax a))
					if ang <= 10.0 then (for i = 1 to 3 where i != k do flags[3 + i] = true)
					else append why ("rotate: Maya " + #("X", "Y", "Z")[free] + " is " + (formattedPrint ang format:".1f") + " deg off the nearest node axis")
				)
				else if l[3].count > 0 do append why "rotate lock with two free axes"
				setTransformLockFlags n flags
				if not flags.isEmpty do locksApplied += 1
				for w in why do append locksSkipped #(l[1], w)
			)
		)
	),

	fn build =
	(
		if (getNodeByName "CTRL_root_ctrl" exact:true) != undefined do remove()
		constrained = #()
		swivelTurns = #()
		local deform = for b in deformBones collect getNodeByName b exact:true

		-- 1. A hidden copy of the deform hierarchy the controls drive.
		local clones = #()
		for n in deform do
		(
			local nn = #()
			maxOps.cloneNodes #(n) cloneType:#copy newNodes:&nn
			nn[1].name = ctrlName n.name
			append clones nn[1]
		)
		for i = 1 to deform.count do
		(
			local k = findItem deform deform[i].parent
			clones[i].parent = if k > 0 then clones[k] else deform[i].parent
			clones[i].renderable = false
			hide clones[i]
		)

		-- 1b. Per limb, hidden fk: and ik: copies of its segment, the first one
		-- under the ctrl: twin of the segment's parent bone.
		for l in limbs do for prefix in #("fk:", "ik:") do
		(
			local prev = undefined
			for b in l[2] do
			(
				local n = getNodeByName b exact:true
				local nn = #()
				maxOps.cloneNodes #(n) cloneType:#copy newNodes:&nn
				local c = nn[1]
				c.name = twinName prefix b
				c.parent = if prev != undefined then prev else ctrlOf n.parent
				c.renderable = false
				hide c
				prev = c
			)
		)

		-- 2. The controls, in the plan's order (parent first). A node takes the
		-- axes of the ctrl: bone of its joint (the root, poles and settings: the
		-- plan's rest TM); the shape keeps the plan's geometry (object offset).
		-- A control that leads a bone (leadBone) is spliced in above it when the
		-- bone's parent is the bone its Maya parent leads (or follows), else the
		-- bone follows it by constraints. IK goals are made here, chained in 3.
		for e in controlPlan do
		(
			local c = twin e[3]
			local tm = if c != undefined and e[5] != "pole" and e[5] != "settings" then c.transform else e[10]
			local pnode = undefined
			local pbone = undefined
			if e[4] != "" then ( pnode = twin e[4]; pbone = pnode )
			else if e[2] != "" do
			(
				pnode = getNodeByName ("CTRL_" + e[2]) exact:true
				pbone = boneUnder (entryOf e[2])
			)
			local lead = leadBone e
			if lead == undefined then makeShape e tm pnode
			else if pbone != undefined and lead.parent == pbone then
			(
				local s = makeShape e tm pbone
				lead.parent = s
			)
			else
			(
				local s = makeShape e tm pnode
				local pc = Position_Constraint()
				lead.position.controller = pc
				pc.appendTarget s 100.0
				local oc = Orientation_Constraint()
				lead.rotation.controller = oc
				oc.appendTarget s 100.0
				append constrained e[1]
			)
		)

		-- The switches: controlRig and hideInactive on the root, ikfk on each
		-- limb's settings control; each parameter gets a Bezier_Float the wiring
		-- below reads.
		local root = getNodeByName "CTRL_root_ctrl" exact:true
		custAttributes.add root.baseObject (rigAttributes())
		root.baseObject.AnimaticaRig[#controlRig].controller = Bezier_Float()
		root.baseObject.AnimaticaRig[#hideInactive].controller = Bezier_Float()
		root.controlRig = 1
		root.hideInactive = hideInactiveDefault
		local rigCtrl = root.baseObject.AnimaticaRig[#controlRig].controller
		local hideCtrl = root.baseObject.AnimaticaRig[#hideInactive].controller

		-- 3. HI IK on the ik: limbs; the goal control (the limb's limbIk control
		-- on the end joint, with the end bone's axes) carries the chain and
		-- orients the ik: end bone, the pole control sets the bend plane.
		for s in ikChains do
		(
			local sb = sceneBone s[3]
			local goalE = undefined
			if sb != undefined do for e in controlPlan where e[5] == "limbIk" and e[3] == sb.name do goalE = e
			local poleE = undefined
			if goalE != undefined do for e in controlPlan where e[5] == "pole" and e[6] == goalE[6] do poleE = e
			local stb = sceneBone s[2]
			local st = if stb != undefined then copyOf "ik:" stb.name else undefined
			local en = if sb != undefined then copyOf "ik:" sb.name else undefined
			if poleE != undefined and st != undefined and en != undefined do
			(
				local mid = en
				while mid.parent != undefined and mid.parent != st do mid = mid.parent
				if mid.parent == st and mid != en do
				(
					local rest = #(st.transform, mid.transform, en.transform)
					local goal = getNodeByName ("CTRL_" + goalE[1]) exact:true
					local sw = getNodeByName ("CTRL_" + poleE[1]) exact:true
					local chain = IKSys.ikChain st en "IKHISolver"
					chain.name = "CTRL_IK_" + s[1]
					chain.parent = goal
					hide chain  -- the goal cube is the control; the chain's gizmo only clutters (it still solves)
					-- The position threshold is measured in the chain's own scaled
					-- space: the default 0.1 is 1 mm under the hero's centimetre
					-- Armature (x0.3937) but 10 cm under a metre one (x39.37), where
					-- the solver then stops short and barely bends the knee. Pin it
					-- to 1 mm. (Much tighter makes HI IK re-solve a nearly straight
					-- rest limb into a different pose.)
					chain.transform.controller.posThresh = (units.decodeValue "1mm") / (length st.transform.row1)
					-- The swivel target is a hidden CTRL_IK_<chain>_swivel, not
					-- the pole control: the pole stays where the plan puts it
					-- (Maya's place) and the target is the pole turned about the
					-- limb axis by the turn HI IK needs to keep the rest pose.
					-- It is linked (Link_Constraint) to CTRL_IK_<chain>_aim at
					-- the start joint, which looks at the goal with its Y axis
					-- towards the pole, so moving the pole still turns the bend
					-- plane, by the same angle as in Maya. A link, not a parent:
					-- HI IK re-solves when its target's own controller reports
					-- a change, which a moved parent does not send.
					local aim = Point name:("CTRL_IK_" + s[1] + "_aim") pos:st.transform.pos
					aim.parent = st.parent
					local la = LookAt_Constraint()
					aim.rotation.controller = la
					la.appendTarget goal 100.0
					la.target_axis = 0
					la.target_axisFlip = false
					la.upnode_world = false
					la.pickUpNode = sw
					la.upnode_ctrl = 0
					la.StoUP_axis = 1
					la.StoUP_axisFlip = false
					-- The turn is found on a free target, then the link keeps its
					-- world place (a linked node's .pos is relative to the link).
					local tgt = Point name:("CTRL_IK_" + s[1] + "_swivel") pos:sw.pos
					hide #(aim, tgt)
					chain.transform.controller.VHTarget = tgt
					local turn = alignSwivel st mid en tgt rest
					local wtm = tgt.transform
					local lc = Link_Constraint()
					tgt.transform.controller = lc
					lc.addTarget aim 0
					tgt.transform = wtm
					append swivelTurns #(s[1], turn[1], turn[2])
					local oc = Orientation_Constraint()
					en.rotation.controller = oc
					oc.appendTarget goal 100.0
					oc.relative = true
				)
			)
		)

		-- 3b. The IK/FK blend: each ctrl: limb bone takes its orientation from
		-- its ik: copy (weight 1 - ikfk) and its fk: copy (weight ikfk); its
		-- position stays its parent's business (the copies share the lengths).
		-- Hide inactive: the FK controls are visible while ikfk > 0, the IK ones
		-- (goal, toe, pole) while ikfk < 1, all of them when hideInactive is 0.
		for l in limbs do
		(
			local settingsNode = undefined
			for e in controlPlan where e[6] == l[1] and e[5] == "settings" do
				settingsNode = getNodeByName ("CTRL_" + e[1]) exact:true
			if settingsNode != undefined do
			(
				custAttributes.add settingsNode.baseObject (limbAttributes())
				settingsNode.baseObject.AnimaticaLimb[#ikfk].controller = Bezier_Float()
				settingsNode.ikfk = l[3]
				local k = settingsNode.baseObject.AnimaticaLimb[#ikfk].controller
				for b in l[2] do
				(
					local c = copyOf "ctrl:" b
					local oc = Orientation_Constraint()
					c.rotation.controller = oc
					oc.appendTarget (copyOf "ik:" b) 50.0
					oc.appendTarget (copyOf "fk:" b) 50.0
					oc[1].controller = expr "(1 - k) * 100" #("k") #(k)
					oc[2].controller = expr "k * 100" #("k") #(k)
				)
				for n in limbControls l[1] #("limbFk") do
				(
					n.visibility = Bezier_Float()
					n[#visibility].controller = expr "if(k > 0, 1, 1 - h)" #("k", "h") #(k, hideCtrl)
				)
				for n in limbControls l[1] #("limbIk", "pole") do
				(
					n.visibility = Bezier_Float()
					n[#visibility].controller = expr "if(k < 1, 1, 1 - h)" #("k", "h") #(k, hideCtrl)
				)
			)
		)

		-- 4. Each mapped deform bone follows its ctrl twin: the list keeps the
		-- original Euler_XYZ (and its keys) in slot 1 for remove() to restore.
		-- The Hips, and a bone whose twin follows a control by constraints (its
		-- position no longer comes from its parent), take the position too.
		-- The constraint layer's weight is the root's controlRig (its controller,
		-- instanced): 0 leaves the bone on its own layer, 1 on the rig.
		for p in jointMap do
		(
			local b = getNodeByName p[2] exact:true
			local c = ctrlOf b
			local old = b.rotation.controller
			local rl = Rotation_List()
			b.rotation.controller = rl
			if rl.count == 0 do rl.available.controller = old
			local oc = Orientation_Constraint()
			rl.available.controller = oc
			oc.appendTarget c 100.0
			rl.setActive 2
			rl[#Weights][2].controller = rigCtrl
			if p[1] == hipsJoint or classOf c.position.controller == Position_Constraint do
			(
				local oldp = b.position.controller
				local pl = Position_List()
				b.position.controller = pl
				if pl.count == 0 do pl.available.controller = oldp
				local pc = Position_Constraint()
				pl.available.controller = pc
				pc.appendTarget c 100.0
				pl.setActive 2
				pl[#Weights][2].controller = rigCtrl
			)
		)
		applyLocks()
		controlNodes = for o in objects where matchPattern o.name pattern:"CTRL_*" ignoreCase:false \
			and not matchPattern o.name pattern:"CTRL_IK_*" ignoreCase:false collect o.name
		ok
	),

	-- frames: an Interval or an array of frame numbers (a BitArray cannot hold frame 0).
	-- Rotations of every mapped bone, positions of the ones that follow by position
	-- (the Hips, and the bones under a constrained ctrl: twin).
	fn bake frames =
	(
		local fr = if classOf frames == Interval then \
			(for f = (frames.start.frame as integer) to (frames.end.frame as integer) collect f) \
			else (for f in frames collect f)
		local joints = for p in jointMap collect getNodeByName p[2] exact:true
		local moved = for b in joints where classOf b.position.controller == Position_List collect b
		local rots = #()
		local poss = #()
		-- Sampled as the local matrix, written as the controller value: the two
		-- share one convention (node.rotation, in any coordsys, does not).
		for f in fr do at time f
		(
			append rots (for b in joints collect (localTM b).rotationpart)
			append poss (for b in moved collect (localTM b).translationpart)
		)
		remove()
		with animate on for i = 1 to fr.count do at time fr[i]
		(
			for k = 1 to joints.count do joints[k].rotation.controller.value = rots[i][k]
			for k = 1 to moved.count do moved[k].position.controller.value = poss[i][k]
		)
		ok
	),

	fn worldTMs = for b in deformBones collect (getNodeByName b exact:true).transform,

	-- (a) The IK/FK blend of the first complete limb (an arm when there is
	-- one): at ikfk 1 turning its middle FK control moves the end bone and moving
	-- its IK goal does not, at ikfk 0 the other way round; the inactive side's
	-- controls are hidden (hideInactive 1) or shown (0). Returns #(ok, message).
	fn limbTest =
	(
		local found = undefined
		for l in limbs where found == undefined do
		(
			local fkMid = undefined
			local goal = undefined
			local sn = undefined
			for e in controlPlan where e[6] == l[1] do
			(
				local n = getNodeByName ("CTRL_" + e[1]) exact:true
				if e[5] == "limbFk" and e[3] == l[2][2] do fkMid = n
				if isIkEnd e do goal = n
				if e[5] == "settings" do sn = n
			)
			if fkMid != undefined and goal != undefined and sn != undefined do found = #(l, fkMid, goal, sn)
		)
		if found == undefined do return #(true, "ikfk: not checked (no complete limb)")
		local l = found[1]
		local fkMid = found[2]
		local goal = found[3]
		local sn = found[4]
		local root = getNodeByName "CTRL_root_ctrl" exact:true
		local endBone = getNodeByName l[2][3] exact:true
		local cm = units.decodeValue "1cm"
		local res = #()
		at time 0 for v in #(1.0, 0.0) do
		(
			sn.ikfk = v
			root.hideInactive = 1
			local p0 = endBone.transform.pos
			local t0 = fkMid.transform
			fkMid.transform = (rotateYMatrix 25.0) * (rotateZMatrix 25.0) * t0
			local dFk = (distance p0 endBone.transform.pos) / cm
			fkMid.transform = t0
			local g0 = goal.transform
			goal.pos = g0.pos + [0, 0, 10.0 * cm]
			local dIk = (distance p0 endBone.transform.pos) / cm
			goal.transform = g0
			local visFk = fkMid[#visibility].controller.value
			local visIk = goal[#visibility].controller.value
			root.hideInactive = 0
			local shown = fkMid[#visibility].controller.value + goal[#visibility].controller.value
			append res #(dFk, dIk, visFk, visIk, shown)
		)
		sn.ikfk = l[3]
		root.hideInactive = hideInactiveDefault
		local r1 = res[1]
		local r0 = res[2]
		local ok = r1[1] > 1.0 and r1[2] < 0.01 and r1[3] > 0.5 and r1[4] < 0.5 and r1[5] > 1.5 \
			and r0[1] < 0.01 and r0[2] > 1.0 and r0[3] < 0.5 and r0[4] > 0.5 and r0[5] > 1.5
		local fmt = "ikfk %=1: %/% moved % by %/% cm, visible %/%; ikfk=0: %/% cm, visible %/%; hideInactive 0 shows both: %"
		local msg = stringStream ""
		format fmt l[1] (substring fkMid.name 6 -1) (substring goal.name 6 -1) endBone.name \
			(formattedPrint r1[1] format:".2f") (formattedPrint r1[2] format:".4f") r1[3] r1[4] \
			(formattedPrint r0[1] format:".4f") (formattedPrint r0[2] format:".2f") r0[3] r0[4] \
			(r1[5] > 1.5 and r0[5] > 1.5) to:msg
		#(ok, msg as string)
	),

	-- (b) controlRig: at 0 the Hips bone plays its own layers (its Euler_XYZ,
	-- set here to a pose of its own, and Position_XYZ), at 1 it is back on the
	-- rig. Returns #(ok, message).
	fn rigLayerTest =
	(
		local root = getNodeByName "CTRL_root_ctrl" exact:true
		local b = if hipsJoint != "" then sceneBone hipsJoint else undefined
		if b == undefined or classOf b.rotation.controller != Rotation_List do
			return #(true, "controlRig: not checked (no Hips list)")
		local rd = 0.0
		local pd = 0.0
		local back = 0.0
		local moved = 0.0
		at time 0
		(
			local layer = b.rotation.controller[1].controller
			local q0 = layer.value
			local w0 = b.transform
			layer.value = (eulerAngles 10 20 30) as quat
			root.controlRig = 0
			rd = tmDiff #((localTM b).rotationpart as matrix3) #(layer.value as matrix3)
			if classOf b.position.controller == Position_List do
				pd = distance (localTM b).translationpart b.position.controller[1].controller.value
			moved = tmDiff #(w0) #(b.transform)
			root.controlRig = 1
			back = tmDiff #(w0) #(b.transform)
			layer.value = q0
		)
		local ok = rd < 1e-4 and pd < 1e-3 and back < 1e-3 and moved > 1e-3
		#(ok, "controlRig 0: " + b.name + " off its Euler_XYZ layer by " + (rd as string) + ", off its Position_XYZ by " \
			+ (pd as string) + "; controlRig 1: back on the rig within " + (back as string))
	),

	-- Returns #(ok, goal control, displacement cm, all Euler_XYZ, nodes before,
	-- nodes after, frame-5 world diff, build drift, non-Euler joints, message).
	-- ok also needs a turn of CTRL_hips_ctrl to leave the Spine1 bone in place
	-- (Maya: hips_ctrl and spine_01 are both under body_ctrl), limbTest() and
	-- rigLayerTest(); the message says what each measured. The goal moved is
	-- that of the first IK chain whose limb is in IK by default (a leg); with
	-- none, the first chain's limb is switched to IK for the test.
	fn selfTest =
	(
		local before = objects.count
		local rest = at time 0 worldTMs()
		build()
		local drift = tmDiff rest (at time 0 worldTMs())
		local msg = ""
		local hipsOk = true
		local hc = getNodeByName "CTRL_hips_ctrl" exact:true
		local sp = sceneBone "Spine1"
		local hb = if hipsJoint != "" then sceneBone hipsJoint else undefined
		if hc != undefined and sp != undefined and hb != undefined then at time 0 \
		(
			local t0 = hc.transform
			local s0 = sp.transform
			local h0 = hb.transform
			hc.transform = (rotateXMatrix 30.0) * (rotateZMatrix 20.0) * t0
			local sd = tmDiff #(s0) #(sp.transform)
			local hd = tmDiff #(h0) #(hb.transform)
			hc.transform = t0
			hipsOk = sd < 1e-3 and hd > 1e-3
			msg = "hips_ctrl turn: Spine1 moved " + (sd as string) + ", Hips " + (hd as string)
		)
		else msg = "hips_ctrl turn: not checked (no hips_ctrl, Spine1 or Hips)"
		local lt = limbTest()
		local rt = rigLayerTest()
		msg += "; " + lt[2] + "; " + rt[2]
		local goal = undefined
		local target = undefined
		local goalLimb = undefined
		for pass = 1 to 2 while goal == undefined do for s in ikChains where goal == undefined do
		(
			local eb = sceneBone s[3]
			if eb != undefined do for e in controlPlan where e[5] == "limbIk" and e[3] == eb.name do
			(
				local l = limbEntry e[6]
				if pass == 2 or (l != undefined and l[3] < 1.0) do
				(
					goal = getNodeByName ("CTRL_" + e[1]) exact:true
					target = eb
					goalLimb = l
				)
			)
		)
		if goal == undefined do
		(
			remove()
			return #(false, "", 0.0, false, before, objects.count, 0.0, drift, "", "no IK goal was built; " + msg)
		)
		if goalLimb != undefined and goalLimb[3] >= 1.0 do
		(
			for e in controlPlan where e[6] == goalLimb[1] and e[5] == "settings" do
				(getNodeByName ("CTRL_" + e[1]) exact:true).ikfk = 0.0
			msg += "; " + goalLimb[1] + " switched to IK for the goal test"
		)
		local goalName = substring goal.name 6 -1
		local p0 = at time 0 target.transform.pos
		local g0 = goal.pos
		with animate on
		(
			at time 0 goal.pos = g0
			at time 10 goal.pos = g0 + [0, 0, units.decodeValue "20cm"]
		)
		local disp = (distance p0 (at time 10 target.transform.pos)) / (units.decodeValue "1cm")
		local controlled = at time 5 worldTMs()
		bake (interval 0 10)
		local bad = #()
		for b in deformBones do
		(
			local n = getNodeByName b exact:true
			if classOf n.rotation.controller != Euler_XYZ do append bad b
			if classOf n.position.controller == Position_List do append bad (b + ".position")
		)
		if hipsJoint != "" and classOf (sceneBone hipsJoint).position.controller != Position_XYZ do
			append bad (hipsJoint + ".position")
		local after = objects.count
		local diff5 = tmDiff controlled (at time 5 worldTMs())
		local passed = disp > 5.0 and bad.count == 0 and after == before and diff5 < 1e-3 and hipsOk \
			and lt[1] and rt[1]
		local bads = ""
		for b in bad do bads += b + " "
		#(passed, goalName, disp, bad.count == 0, before, after, diff5, drift, bads, msg)
	)
)

global AnimaticaControls = AnimaticaControls_def()
